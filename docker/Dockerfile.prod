# === Builder stage ===
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./

# This image runs the API with every module, the arq worker and the alembic
# migrations, so it needs the database/queue packages (data) and the screen
# converter (convert).
# The convert extra is a git source in a private repository. The read token is
# a BuildKit secret, handed to git through the environment of the one command
# that fetches, so no layer and no file in the image holds it.
RUN --mount=type=secret,id=converter_mirror_token,required=true \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0="url.https://x-access-token:$(cat /run/secrets/converter_mirror_token)@github.com/als-apg/canopy-osprey-mirror-pydm-converter-tool.insteadOf" \
    GIT_CONFIG_VALUE_0="https://github.com/als-apg/canopy-osprey-mirror-pydm-converter-tool" \
    uv sync --frozen --no-dev --extra data --extra convert --no-install-project

COPY src/ ./src/
COPY .git/ ./.git/

# --no-editable bakes the canopy package into the venv's site-packages instead
# of linking to /app/src. The prod stage copies only /app/.venv (not src/), so
# an editable install would leave `import canopy` dangling at runtime.
RUN --mount=type=secret,id=converter_mirror_token,required=true \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0="url.https://x-access-token:$(cat /run/secrets/converter_mirror_token)@github.com/als-apg/canopy-osprey-mirror-pydm-converter-tool.insteadOf" \
    GIT_CONFIG_VALUE_0="https://github.com/als-apg/canopy-osprey-mirror-pydm-converter-tool" \
    uv sync --frozen --no-dev --extra data --extra convert --no-editable

RUN rm -rf .git

# === Production stage ===
FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH"

# The deploy playbook runs migrations as `compose run --rm api <migration_command>`,
# so the image must carry the alembic tree.
COPY alembic.ini ./
COPY migrations/ ./migrations/

# Facility ops mint keys via `compose run --rm api python scripts/create_key.py ...`,
# so the bootstrap CLI has to ship in the image too.
COPY scripts/ ./scripts/

RUN useradd --create-home --shell /bin/bash --no-log-init appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c 'import os, urllib.request; urllib.request.urlopen("http://localhost:" + os.environ.get("API_PORT", "8000") + "/health")' || exit 1

CMD ["uvicorn", "canopy.main:app", "--host", "0.0.0.0", "--port", "8000"]
